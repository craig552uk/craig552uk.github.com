---js
const eleventyNavigation = {
	key: "Home",
	order: 1
};

const numberOfLatestPostsToShow = 3;
---

<div class="md:flex justify-between">
	<div class="flex justify-center">
		<img src="/img/avatar.jpeg" alt="Avatar" class="rounded-full md:w-48 md:h-48 w-64 h-64">
	</div>
	<div class="flex-1 md:pl-8">
		<div class="text-xl mb-4">Hello, I'm Craig 👋</div>

		<ul role="list" class="space-y-4">
			<li class="flex gap-x-2">
				<div>😃</div>
				<div>I write software for money and words for fun.</div>
			</li>
			<li class="flex gap-x-2">
				<div>👾</div>
				<div>Connect on <a href="https://www.linkedin.com/in/craigrussell1983/" target="_blank" class="font-bold hover:underline">LinkedIn</a> 
					if you need help with your project.
				</div>
			</li>
			<li class="flex gap-x-2">
				<div>📚</div>
				<div>My latest book is <a href="/no-fixed-ground" class="font-bold hover:underline">No Fixed Ground: On Living in Uncertainty</a>.</div>
			</li>
		</ul>
	</div>
</div>

{% include "mailingListForm.njk" %}

<div>
	{# Show latest 5 on home page #}
	<h2 class="text-3xl font-bold mb-4">Latest Posts</h2>
	{% for post in collections.posts | head(-5) | reverse %}
		{% include "postcard.njk" %}
	{% endfor %}

	<a class="group block rounded border hover:bg-gray-50 p-2 text-lg hover:shadow-md pointer" href="/blog/">
        <div class="text-center">All Posts</div>
    </a>
</div>
